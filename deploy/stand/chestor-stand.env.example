# /etc/chestor-stand.env — настройки деплоя стенда (в git не кладётся).
# Папка с клоном репозитория для стенда; в ней свой .env с токеном тестового бота.
STAND_DIR=/root/chestor_test
# Кому писать о деплое: твой Telegram id (тестовый бот должен быть тебе открыт).
NOTIFY_CHAT_ID=123456789
# Сервисы docker compose через пробел; зависимости (postgres, migrations) поднимутся сами.
STAND_SERVICES=bot
# Имя проекта docker compose для стенда.
STAND_PROJECT=chestor_test
# Необязательно: токен GitHub без прав. Без него у API лимит 60 запросов в час с IP сервера.
# GITHUB_TOKEN=
