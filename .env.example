BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOSTNAME=postgres
POSTGRES_DATABASE=development
PGADMIN_DEFAULT_EMAIL=default_email 
PGADMIN_DEFAULT_PASSWORD=default_password
HTTP_PROXY=
HTTPS_PROXY=

# Токен бота для порта на selfrotgram (сервис selfrot_bot, только тестовый стенд).
# Отдельный от BOT_TOKEN: порт не должен запускаться на токене прод-бота.
# SELFROT_BOT_TOKEN=

# Квиз порта (ghoul_quiz 0.2): email, под которым сохранена сессия квиза.
# Войти один раз: poetry run ghoul-quiz-register; токены лягут в ./.ghoul_quiz/tokens.json
# (или в файл из GHOUL_QUIZ_TOKEN_PATH). Одну сессию не держать в двух окружениях сразу.
# GHOUL_QUIZ_EMAIL=
# GHOUL_QUIZ_TOKEN_PATH=
# GHOUL_QUIZ_API_URL=https://chestor.site/api

# Host-side port for the bot's webhook listener (container side always stays 8999).
# Only needed if you run a second stack (e.g. a test bot) alongside this one on
# the same host, to avoid "port is already allocated". Leave unset for normal use.
# BOT_EXTERNAL_PORT=8998