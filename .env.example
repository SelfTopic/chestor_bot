BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOSTNAME=postgres
POSTGRES_DATABASE=development
PGADMIN_DEFAULT_EMAIL=default_email 
PGADMIN_DEFAULT_PASSWORD=default_password
HTTP_PROXY=
HTTPS_PROXY=

# ENV=DEV — polling. Любое другое значение — вебхук на порту 8999 (nginx проксирует на
# него публичный WEBHOOK_URL); секрет уходит в заголовке X-Telegram-Bot-Api-Secret-Token:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# WEBHOOK_URL=https://chestor.site/webhook/bot
# WEBHOOK_SECRET=

# Квиз порта (ghoul_quiz 0.2): email, под которым сохранена сессия квиза.
# Войти один раз: poetry run ghoul-quiz-register; токены лягут в ./.ghoul_quiz/tokens.json
# (или в файл из GHOUL_QUIZ_TOKEN_PATH). Одну сессию не держать в двух окружениях сразу.
# GHOUL_QUIZ_EMAIL=
# GHOUL_QUIZ_TOKEN_PATH=
# GHOUL_QUIZ_API_URL=https://chestor.site/api

# Огрызания через нейросеть (Cloud.ru Foundation Models, API как у OpenAI). Без ключа или
# с ROAST_ENABLED=false бот отвечает только шаблонами. Ключ сервисного аккаунта; для прода
# лучше ограничить его IP сервера.
# LLM_API_KEY=
# LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
# ROAST_ENABLED=true
# ROAST_MODEL=deepseek-ai/DeepSeek-V4-Pro
# ROAST_DAILY_LIMIT=500
# ROAST_TIMEOUT=25

# «бот найди»: поиск Tavily (tavily.com, 1000 бесплатных запросов в месяц) + ответ модели
# через LLM_API_KEY выше. Без любого из ключей бот отвечает «поиск выключен».
# TAVILY_API_KEY=
# SEARCH_MODEL=deepseek-ai/DeepSeek-V4-Pro
# SEARCH_DAILY_LIMIT=30
# SEARCH_COOLDOWN=60
# SEARCH_TIMEOUT=25

# Видео по ссылкам TikTok/YouTube: yt-dlp из своего venv (в образе /opt/media-tools/bin),
# ролики длиннее LINK_MEDIA_MAX_DURATION секунд не качаются.
# MEDIA_TOOLS_DIR=/opt/media-tools/bin
# LINK_MEDIA_MAX_DURATION=900
# «песня …»: треки длиннее MUSIC_MAX_DURATION секунд в выдачу не попадают.
# MUSIC_MAX_DURATION=900

# Канал документации для игроков: бот при запуске публикует и правит в нём посты из
# docs/players/*.md. Бот должен быть админом канала с правом публиковать и редактировать.
# Прод — @chestor_docs, стенд — @chestor_docs_test. Пусто — не публиковать.
# DOCS_CHANNEL=@chestor_docs
# Английская справка (docs/players/en/*.md) — в свой канал. Прод — @chestor_docs_en.
# DOCS_CHANNEL_EN=@chestor_docs_en

# Канал, подписка на который нужна для игры (все команды гуля). Бот должен быть админом
# канала: иначе Telegram не отвечает, кто подписан, и игра остаётся открытой. Пусто — без подписки.
# SUBSCRIPTION_CHANNEL=@chestor_channel

# id аккаунта юзербота (src/userbot_parser): от него бот принимает пересланные серии аниме и
# эдиты для «1000-7». Юзербот пишет его в лог при запуске. 0 — пересылки не принимаются.
# USERBOT_ID=0

# Host-side port for the bot's webhook listener (container side always stays 8999).
# Only needed if you run a second stack (e.g. a test bot) alongside this one on
# the same host, to avoid "port is already allocated". Leave unset for normal use.
# BOT_EXTERNAL_PORT=8998

# Логи порта: в консоль — от LOG_LEVEL (DEBUG, INFO, WARNING, ERROR, CRITICAL;
# DEBUG — всё, кроме SQLAlchemy: она всегда только WARNING и выше), в файл LOG_FILE —
# только WARNING и выше, с ротацией 5 МБ × 3.
# LOG_LEVEL=INFO
# LOG_FILE=logs.log
